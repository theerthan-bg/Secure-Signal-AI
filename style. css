* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #07111f;
    color: white;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 8%;
    background: #050b14;
}

.logo {
    font-size: 24px;
    font-weight: bold;
}

.logo span {
    color: #00e5ff;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 25px;
}

.hero {
    min-height: 80vh;
    display: flex;
    align-items: center;
    padding: 8%;
}

.hero-content {
    max-width: 700px;
}

.tag {
    color: #00e5ff;
    letter-spacing: 3px;
}

h1 {
    font-size: 64px;
    margin: 20px 0;
}

h1 span {
    color: #00e5ff;
}

.hero p {
    font-size: 18px;
    line-height: 1.7;
}

button {
    margin-top: 25px;
    padding: 14px 25px;
    border: none;
    border-radius: 8px;
    background: #00e5ff;
    color: #001018;
    font-weight: bold;
    cursor: pointer;
}

.scanner {
    padding: 80px 8%;
    background: #0b1828;
}

.scanner h2,
#features h2 {
    font-size: 38px;
    margin-bottom: 15px;
}

textarea {
    width: 100%;
    max-width: 800px;
    height: 160px;
    margin-top: 25px;
    padding: 15px;
    border-radius: 10px;
    background: #101f31;
    color: white;
    border: 1px solid #263d55;
    resize: vertical;
}

#result {
    margin-top: 20px;
    max-width: 800px;
}

#features {
    padding: 80px 8%;
}

.features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 30px;
}

.card {
    padding: 30px;
    background: #0d1b2c;
    border-radius: 12px;
    border: 1px solid #20354d;
}

.card h3 {
    margin-bottom: 10px;
}

.card p {
    color: #b8c7d9;
    line-height: 1.6;
}

footer {
    text-align: center;
    padding: 30px;
    background: #050b14;
}

@media (max-width: 700px) {

    h1 {
        font-size: 42px;
    }

    .features {
        grid-template-columns: 1fr;
    }

    nav {
        display: none;
    }
}